</Base>

<script>
  const root = document.documentElement;
  const slug = (t: string) => t.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/đ/g, "d").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  const fold = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/đ/g, "d");

  // anchors on every h3 + the sub-list of the section being read, under its item in the side menu
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".docs__nav a")];
  const byId = new Map(navLinks.map((a) => [a.hash.slice(1), a]));
  document.querySelectorAll<HTMLElement>(".doc section[id]").forEach((sec) => {
    const heads = [...sec.querySelectorAll<HTMLElement>("h3")];
    const sub = document.createElement("div");
    sub.className = "docs__sub";
    heads.forEach((h, i) => {
      const label = h.querySelector<HTMLElement>("[data-l=vi]")?.textContent || h.textContent || "";
      h.id = `${sec.id}-${slug(label) || i}`;
      const a = document.createElement("a");
      a.href = `#${h.id}`;
      const vi = h.querySelector("[data-l=vi]")?.textContent, en = h.querySelector("[data-l=en]")?.textContent;
      a.innerHTML = vi && en ? `<span data-l="vi">${vi}</span><span data-l="en">${en}</span>` : h.textContent!;
      sub.append(a);
    });
    if (heads.length) byId.get(sec.id)?.after(sub);
  });

  const secs = [...document.querySelectorAll<HTMLElement>(".doc section[id]")];
  function spy() {
    const y = window.scrollY + window.innerHeight * 0.25;
    let cur = secs[0];
    for (const s of secs) if (s.offsetTop <= y) cur = s;
    navLinks.forEach((a) => (a.hash.slice(1) === cur.id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
    document.querySelectorAll<HTMLElement>(".docs__sub").forEach((d) => (d.dataset.open = String((d.previousElementSibling as HTMLAnchorElement)?.hash.slice(1) === cur.id)));
  }
  addEventListener("scroll", spy, { passive: true });
  spy();

  // command filter: hides every row that does not match, keeps headings so the reader keeps their place
  const q = document.getElementById("dq") as HTMLInputElement;
  const count = document.getElementById("dq-count")!;
  const rows = [...document.querySelectorAll<HTMLElement>(".doc .rowlist li, .doc .tbl > div")];
  rows.forEach((r) => (r.dataset.hay = fold(r.textContent || "")));
  function filter() {
    const words = fold(q.value).trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    rows.forEach((r) => {
      const ok = words.every((w) => r.dataset.hay!.includes(w));
      r.hidden = !ok;
      if (ok) shown++;
    });
    count.textContent = words.length ? `${shown} / ${rows.length}` : "";
    root.toggleAttribute("data-filtering", words.length > 0);
  }
  q.addEventListener("input", filter);
  document.addEventListener("keydown", (e) => {
    if (e.key === "/" && !/^(INPUT|TEXTAREA)$/.test((e.target as Element).tagName)) { e.preventDefault(); q.focus(); q.select(); }
  });
</script>
