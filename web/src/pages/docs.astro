          {pn("faq").next ? (<a class="pn__next" href={`#${pn("faq").next[0]}`}><small><T vi="Tiếp theo" en="Next" /></small><T vi={pn("faq").next[1]} en={pn("faq").next[2]} /></a>) : <span />}
